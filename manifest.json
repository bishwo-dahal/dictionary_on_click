{
  "manifest_version": 3,
  "name": "Dictionary on Click",
  "version": "0.1.0",
  "description": "Double-click any word to see its definition. Reliable, free, no API keys.",
  "icons": {
    "48": "assets/icons/icon.svg",
    "96": "assets/icons/icon.svg"
  },
  "action": {
    "default_title": "Dictionary on Click",
    "default_popup": "popup/index.html",
    "default_icon": {
      "48": "assets/icons/icon.svg"
    }
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "permissions": ["storage"],
  "host_permissions": [
    "*://*.wiktionary.org/*",
    "*://*.wikipedia.org/*",
    "https://api.dictionaryapi.dev/*",
    "https://api.datamuse.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["content.js"],
      "type": "module",
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "dictionary-on-click@bishwo-dahal.local",
      "strict_min_version": "120.0"
    }
  }
}
