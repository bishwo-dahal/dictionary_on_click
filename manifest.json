{
  "manifest_version": 3,
  "name": "Dictionary on Click",
  "version": "0.1.0",
  "description": "Double-click any word to see its definition. Reliable, free, no API keys.",
  "icons": {
    "48": "assets/icons/icon-48.png",
    "96": "assets/icons/icon-96.png"
  },
  "action": {
    "default_title": "Dictionary on Click",
    "default_popup": "popup/index.html",
    "default_icon": {
      "48": "assets/icons/icon-48.png"
    }
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "permissions": ["storage"],
  "web_accessible_resources": [
    {
      "resources": ["audio/speak.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "host_permissions": [
    "*://*.wiktionary.org/*",
    "*://*.wikipedia.org/*",
    "*://upload.wikimedia.org/*",
    "https://api.dictionaryapi.dev/*",
    "https://api.datamuse.com/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["content.js"],
      "type": "module",
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "dictionary-on-click@bishwo-dahal.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
