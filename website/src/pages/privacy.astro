---
import { breadcrumb, orgGraph } from '../data/jsonld';
import { site } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const jsonLd = orgGraph('/privacy', [
  breadcrumb([
    { name: 'Home', path: '/' },
    { name: 'Privacy', path: '/privacy' },
  ]),
]);
---

<BaseLayout
  title="Privacy | Dictionary on Click"
  description="Dictionary on Click asks for storage and narrow dictionary API hosts. No remote telemetry. History is opt-in. Data stays on your device."
  path="/privacy"
  jsonLd={jsonLd}
>
  <article class="mx-auto max-w-3xl px-4 py-16 md:px-6 md:py-24">
    <p class="overline-label">Permissions</p>
    <h1 class="mt-4 font-display text-4xl leading-[1.1] md:text-6xl">
      What this extension can and cannot see
    </h1>
    <p class="prose-drop mt-8 text-lg leading-relaxed text-foreground">
      A dictionary on the page only works if it can store a cache and talk to a few word APIs. That is the whole bargain. It does not need your identity, and it does not ship your reading list anywhere.
    </p>

    <section class="mt-16 border-t border-border pt-10">
      <h2 class="font-display text-2xl md:text-4xl">Permissions</h2>
      <div class="mt-6 overflow-x-auto">
        <table class="w-full min-w-[28rem] text-left text-sm">
          <thead>
            <tr class="border-b border-border text-muted">
              <th class="py-2 font-medium">Permission</th>
              <th class="py-2 font-medium">Why</th>
            </tr>
          </thead>
          <tbody class="text-foreground">
            <tr class="border-b border-border">
              <td class="py-3 font-mono text-xs">storage</td>
              <td class="py-3 text-muted">Options, cache, local stats, optional history.</td>
            </tr>
            <tr>
              <td class="py-3 font-mono text-xs">Host access</td>
              <td class="py-3 text-muted">
                Dictionary APIs only (Wiktionary, Free Dictionary API, Datamuse). Not a license to scrape every site you open.
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="mt-16 border-t border-border pt-10">
      <h2 class="font-display text-2xl md:text-4xl">No remote telemetry</h2>
      <p class="mt-4 leading-relaxed text-muted">
        Usage counts and similar stats stay in the browser. There is no analytics pixel on this marketing site either. Firefox listing uses
        <span class="font-mono text-xs text-foreground">data_collection_permissions: none</span>.
      </p>
    </section>

    <section class="mt-16 border-t border-border pt-10">
      <h2 class="font-display text-2xl md:text-4xl">History is opt-in</h2>
      <p class="mt-4 leading-relaxed text-muted">
        Lookup history does not run until you turn it on in options. You can clear it there. Default is off.
      </p>
    </section>

    <section class="mt-16 border-t border-border pt-10">
      <h2 class="font-display text-2xl md:text-4xl">Where words come from</h2>
      <p class="mt-4 leading-relaxed text-muted">
        Definitions are fetched from public APIs. Wiktionary content is available under
        <a class="text-accent hover:text-accent-hover" href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA</a>.
        This site and the extension are not affiliated with the Wikimedia Foundation.
      </p>
    </section>

    <section class="mt-16 border-t border-border pt-10">
      <h2 class="font-display text-2xl md:text-4xl">This website</h2>
      <p class="mt-4 leading-relaxed text-muted">
        {site.url} is a static page. It does not set an account cookie. Store installs happen on Mozilla and Google domains.
      </p>
    </section>
  </article>
</BaseLayout>
