---
import FaqList from '../components/FaqList.astro';
import Icon from '../components/Icon.astro';
import InstallButtons from '../components/InstallButtons.astro';
import ProductShot from '../components/ProductShot.astro';
import Shot from '../components/Shot.astro';
import { orgGraph } from '../data/jsonld';
import { site } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const jsonLd = orgGraph('/');
---

<BaseLayout
  title="Dictionary on Click | Look up words without leaving the page"
  description="Double-click any word for a definition bubble. Dictionary on Click is a free Firefox and Chrome extension with no API keys and data stored on your device."
  path="/"
  jsonLd={jsonLd}
>
  <section class="px-4 pb-8 pt-14 md:px-6 md:pb-12 md:pt-20">
    <div class="mx-auto max-w-3xl text-center">
      <h1 class="font-display text-4xl leading-[1.12] text-foreground md:text-6xl">
        Dictionary on Click
      </h1>
      <p class="mx-auto mt-5 max-w-xl text-base text-muted md:text-lg">
        Double-click any word for a definition bubble. Free for Firefox and Chrome. No account. No API key.
      </p>
    </div>
    <div class="mt-10">
      <InstallButtons />
    </div>
    <div class="mt-12 md:mt-16">
      <ProductShot />
    </div>
    <div class="mx-auto mt-8 grid max-w-5xl gap-6 md:grid-cols-2">
      <Shot
        src="/screenshots/toolbar-lookup.png"
        alt="Toolbar Dictionary popup with lookup field, language, and theme controls"
        width={951}
        height={559}
      />
      <Shot
        src="/screenshots/bubble-apotheosis.png"
        alt="In-page bubble defining apotheosis over a highlighted word in an article"
        width={951}
        height={559}
      />
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-16 md:px-6 md:py-20">
    <p class="overline-label">Lookup</p>
    <h2 class="mt-3 font-display text-2xl md:text-4xl">How a lookup actually works</h2>
    <ol class="mt-10 space-y-0">
      {
        [
          { n: '01', icon: 'mouse' as const, t: 'Double-click', d: 'Select a word on any page. That click is the lookup.' },
          { n: '02', icon: 'bubble' as const, t: 'Read the bubble', d: 'A closed Shadow DOM card shows the headword, sound, part of speech, and a short gloss.' },
          { n: '03', icon: 'panel' as const, t: 'Open the toolbar', d: 'Use the toolbar popup to copy, share, or hear pronunciation.' },
        ].map((step) => (
          <li class="flex gap-4 border-t border-border py-6">
            <Icon name={step.icon} class="mt-1 h-5 w-5 shrink-0 text-accent" />
            <div>
              <p class="font-mono text-[11px] text-muted">{step.n}</p>
              <h3 class="mt-1 text-lg font-semibold">{step.t}</h3>
              <p class="mt-1 text-sm leading-relaxed text-muted">{step.d}</p>
            </div>
          </li>
        ))
      }
    </ol>
    <p class="mt-2">
      <a class="text-sm font-medium text-accent hover:text-accent-hover" href="/how-it-works">
        Full walkthrough
      </a>
    </p>
  </section>

  <section class="mx-auto max-w-3xl px-4 pb-16 md:px-6 md:pb-20">
    <p class="overline-label">Reliability</p>
    <h2 class="mt-3 font-display text-2xl md:text-4xl">Built so free dictionaries do not fail you</h2>
    <ul class="mt-10">
      <li class="flex gap-4 border-t border-border py-6">
        <Icon name="languages" class="mt-1 h-5 w-5 shrink-0 text-accent" />
        <div>
          <h3 class="font-semibold">Fallback chain</h3>
          <p class="mt-1 text-sm leading-relaxed text-muted">
            Wiktionary, then Free Dictionary API, then Datamuse. If one provider is down, the next one tries.
          </p>
        </div>
      </li>
      <li class="flex gap-4 border-t border-border py-6">
        <Icon name="shield" class="mt-1 h-5 w-5 shrink-0 text-accent" />
        <div>
          <h3 class="font-semibold">Circuit breaker</h3>
          <p class="mt-1 text-sm leading-relaxed text-muted">
            Flaky APIs get a rest instead of hammering your tab with retries that never land.
          </p>
        </div>
      </li>
      <li class="flex gap-4 border-t border-border py-6">
        <Icon name="database" class="mt-1 h-5 w-5 shrink-0 text-accent" />
        <div>
          <h3 class="font-semibold">IndexedDB cache</h3>
          <p class="mt-1 text-sm leading-relaxed text-muted">
            Words you already looked up can load offline. This is not a bundled dictionary of the whole language.
          </p>
        </div>
      </li>
    </ul>
    <p class="mt-2 flex items-center gap-2 text-sm text-muted">
      <Icon name="languages" class="h-4 w-4 text-accent" />
      Eighteen dictionary languages. System, light, or dark in the extension UI.
    </p>
    <p class="mt-6">
      <a class="text-sm font-medium text-accent hover:text-accent-hover" href="/features">
        All capabilities
      </a>
    </p>
  </section>

  <section class="border-y border-border">
    <div class="mx-auto max-w-3xl px-4 py-16 text-center md:px-6 md:py-20">
      <h2 class="font-display text-2xl md:text-4xl">Add it to your browser</h2>
      <p class="mx-auto mt-3 max-w-xl text-muted">
        Official listings on Firefox Add-ons and the Chrome Web Store. v{site.version}.
      </p>
      <div class="mt-10">
        <InstallButtons />
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-16 md:px-6 md:py-24">
    <h2 class="font-display text-2xl md:text-4xl">Questions people actually ask</h2>
    <div class="mt-8">
      <FaqList />
    </div>
  </section>
</BaseLayout>
