---
import { nav, site } from '../data/site';
import Icon from './Icon.astro';
---

<footer class="border-t border-border bg-elevated">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-16 md:grid-cols-4 md:px-6">
    <div>
      <p class="font-display text-lg text-foreground">Dictionary on Click</p>
      <p class="mt-3 text-sm text-muted">
        A definition bubble for people who read on the web. v{site.version}.
      </p>
    </div>
    <div>
      <p class="overline-label mb-3">Product</p>
      <ul class="space-y-2 text-sm">
        {
          nav.map((item) => (
            <li>
              <a
                class="text-muted hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
                href={item.href}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <p class="overline-label mb-3">Install</p>
      <ul class="space-y-2 text-sm">
        <li>
          <a
            class="inline-flex items-center gap-2 text-muted hover:text-accent"
            href={site.firefox}
          >
            Add to Firefox
            <Icon name="external" class="h-3.5 w-3.5" />
          </a>
        </li>
        <li>
          <a
            class="inline-flex items-center gap-2 text-muted hover:text-accent"
            href={site.chrome}
          >
            Add to Chrome
            <Icon name="external" class="h-3.5 w-3.5" />
          </a>
        </li>
      </ul>
    </div>
    <div>
      <p class="overline-label mb-3">Source</p>
      <ul class="space-y-2 text-sm">
        <li>
          <a
            class="inline-flex items-center gap-2 text-muted hover:text-accent"
            href={site.github}
          >
            <Icon name="github" class="h-4 w-4" />
            GitHub
          </a>
        </li>
        <li>
          <a class="text-muted hover:text-accent" href={site.buildMd}>BUILD.md</a>
        </li>
        <li>
          <a class="text-muted hover:text-accent" href="/privacy">Privacy</a>
        </li>
        <li>
          <span class="text-muted">{site.license}</span>
        </li>
      </ul>
    </div>
  </div>
  <div class="border-t border-border">
    <p class="mx-auto max-w-6xl px-4 py-6 text-xs text-muted md:px-6">
      Maintained by {site.author}. Wiktionary text is available under
      <a class="underline hover:text-accent" href="https://creativecommons.org/licenses/by-sa/4.0/">
        CC BY-SA
      </a>.
    </p>
  </div>
</footer>
