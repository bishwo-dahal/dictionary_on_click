---
import Icon from './Icon.astro';
---

<div class="ext-bubble" data-ext-bubble>
  <div class="bubble-head">
    <div>
      <p class="lemma"></p>
      <p class="ipa"></p>
    </div>
    <span class="bubble-icons">
      <Icon name="volume" class="h-4 w-4" />
      <Icon name="alert" class="h-4 w-4" />
    </span>
  </div>
  <ul class="senses"></ul>
  <a class="full-btn" href="/install">See full definition</a>
</div>

<style>
  .ext-bubble {
    --font: system-ui, -apple-system, 'Segoe UI', Roboto, 'Noto Sans', Ubuntu,
      Cantarell, 'Helvetica Neue', Arial, sans-serif;
    box-sizing: border-box;
    width: 340px;
    max-width: min(340px, 100%);
    padding: 14px 16px 16px;
    font-family: var(--font);
    font-size: 14px;
    line-height: 1.5;
    color: #f1f5f9;
    background: #1a2333;
    border: 1px solid #334155;
    border-radius: 12px;
    box-shadow: 0 16px 40px rgba(15, 23, 42, 0.28);
    -webkit-font-smoothing: antialiased;
  }

  .bubble-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 12px;
  }

  .lemma {
    margin: 0;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #fff;
    line-height: 1.2;
  }

  .ipa {
    margin: 2px 0 0;
    font-size: 13px;
    color: #9ca3af;
  }

  .bubble-icons {
    display: flex;
    gap: 8px;
    color: #9ca3af;
  }

  .senses {
    margin: 0 0 12px;
    padding: 0;
    list-style: none;
  }

  .senses :global(li) {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    margin: 0 0 10px;
  }

  .senses :global(.pos) {
    flex-shrink: 0;
    margin-top: 2px;
    padding: 1px 8px;
    font-size: 11px;
    font-weight: 600;
    line-height: 1.5;
    border-radius: 4px;
  }

  .senses :global(.pos-adj),
  .senses :global(.pos-adv) {
    color: #bbf7d0;
    background: #14532d;
  }

  .senses :global(.pos-noun),
  .senses :global(.pos-det) {
    color: #dbeafe;
    background: #1d4ed8;
  }

  .senses :global(.pos-verb) {
    color: #fde68a;
    background: #92400e;
  }

  .senses :global(.pos-prep),
  .senses :global(.pos-conj),
  .senses :global(.pos-pronoun) {
    color: #e9d5ff;
    background: #6b21a8;
  }

  .senses :global(.gloss) {
    font-size: 13px;
    line-height: 1.5;
    color: #e5e7eb;
  }

  .full-btn {
    display: inline-block;
    padding: 7px 12px;
    font-size: 13px;
    font-weight: 600;
    color: #fff;
    background: #2563eb;
    border-radius: 6px;
    text-decoration: none;
  }

  .full-btn:hover,
  .full-btn:focus-visible {
    background: #1d4ed8;
  }
</style>
